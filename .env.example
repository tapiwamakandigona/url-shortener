# Durable storage (required in production — the server refuses to start without it).
# A missing store used to mean "keep links in memory", which lost every link whenever the
# container recycled.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB=voltdb

# Admin endpoints (/api/urls list + delete). Without this they return 503 — never open.
ADMIN_API_KEY=

# Salt for hashing visitor IPs in the click log. Set it, or restarts change the hash.
IP_HASH_SALT=

# Local development only: use in-process storage instead of a database.
# STORE=memory
