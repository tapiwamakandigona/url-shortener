{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL shortener with click analytics",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "cd client && npm run build && cd .. && tsc -p tsconfig.server.json",
    "build:bundle": "cd client && npm ci && npm run build && cd .. && esbuild server/index.ts --bundle --platform=node --target=node22 --outfile=dist-bundle/server.js && rm -rf dist-bundle/dist && cp -r client/dist dist-bundle/dist",
    "start:bundle": "CLIENT_DIST=dist-bundle/dist node dist-bundle/server.js",
    "test": "jest --passWithNoTests",
    "check:restart": "node scripts/restart-check.mjs",
    "check:preview": "node scripts/verify-preview.mjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "node-appwrite": "^27.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.1",
    "jest": "^29.7.0",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.11",
    "typescript": "^5.3.0"
  },
  "author": "Tapiwa Makandigona",
  "license": "MIT"
}
